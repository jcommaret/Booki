{
  "name": "booki",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://jcommaret.github.io/booki",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:analyze": "tsc -b && vite build --mode analyze",
    "analyze": "npm run build:analyze",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc -b",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,scss,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,scss,json,md}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "validate": "npm run lint && npm run format:check && npm run type-check && npm run test:coverage && npm run build",
    "prepare": "husky",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "@fontsource/raleway": "^5.2.5",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@eslint/js": "^9.22.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "eslint": "^9.22.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.0.0",
    "prettier": "^3.5.3",
    "rollup-plugin-visualizer": "^7.0.0",
    "sass-embedded": "^1.87.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "gh-pages": "^6.3.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
